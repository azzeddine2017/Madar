[Ring 1.27 Fast Cheatsheet > ### 3. Functions & Methods]

```ring
func calculateTotal aItems {
    if type(aItems) != "LIST" {
        raise("Error: Expected list parameter")
    }
    nTotal = 0
    for nVal in aItems {
        nTotal += nVal
    }
    return nTotal
}
```

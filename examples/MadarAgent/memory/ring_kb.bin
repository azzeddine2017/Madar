FSTRINGS.md_c7
[Madar Feature: F-Strings > ## 5. Examples]


```ring
# Simple greeting
name = "Madar"
see f"Welcome to {name}!" + nl

# Arithmetic calculations
price = 150
tax = 0.19
see f"Total price: {price * (1 + tax)} DZD" + nl

# Conditional statements
user = "admin"
if f"user_{user}" = "user_admin"
    see "Access granted." + nl
ok
